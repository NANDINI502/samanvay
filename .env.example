# Nebius Token Factory
NEBIUS_API_KEY=your_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs — confirm exact identifiers in the Nebius Token Factory console.
# The Super ID below is from Nebius's own Nemotron page; the Ultra ID is a guess.
NEMOTRON_ORCHESTRATOR_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Router (strict-JSON organ picker); empty = use NEMOTRON_AGENT_MODEL
NEMOTRON_ROUTER_MODEL=

# nemotron (default; keyword routing is the fallback) or keyword
MEDBOT_ROUTER=nemotron
MEDBOT_ROUTER_TIMEOUT_S=10

# Retrieval embeddings: tfidf (offline, default) or nebius
EMBED_BACKEND=tfidf
# Required only when EMBED_BACKEND=nebius — an embedding model ID from the console
NEBIUS_EMBED_MODEL=

# One-way safety check (orchestrator/safety.py): timeout in seconds; on timeout
# the deterministic guardrail result stands
MEDBOT_SAFETY_TIMEOUT_S=10

# 1 = run the whole pipeline offline with labelled stub replies instead of Nemotron
MEDBOT_MOCK_LLM=0

# Public-demo limits on /api/ask (api/ratelimit.py); 0 turns a limit off
MEDBOT_RATE_PER_IP=10
MEDBOT_RATE_WINDOW_S=3600
MEDBOT_DAILY_CAP=200
# Ceiling on max_tokens for every model call
MEDBOT_MAX_TOKENS_CAP=4000

# Live web fallback (rag/web.py): only when an agent's corpus has no confident
# match; WHO / NIH / CDC pages only; labelled "Live web source". Off by default.
MEDBOT_WEB_FALLBACK=0
TAVILY_API_KEY=
MEDBOT_WEB_TIMEOUT_S=10
MEDBOT_WEB_MAX_RESULTS=3
